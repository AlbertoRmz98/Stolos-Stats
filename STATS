
import csv
import io
import json
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

DATA = Path("data")
DATA.mkdir(exist_ok=True)

def download(url):
    request = urllib.request.Request(
        url,
        headers={"User-Agent": "StolosStats/1.0"}
    )
    with urllib.request.urlopen(request, timeout=60) as response:
        return response.read()

def update_soccer():
    leagues = {
        "E0": "Premier League",
        "SP1": "La Liga",
        "I1": "Serie A",
        "D1": "Bundesliga",
        "F1": "Ligue 1",
    }
    matches = []
    # Últimas temporadas disponibles y anteriores
    for start_year in range(2019, datetime.now().year):
        season = f"{start_year % 100:02d}{(start_year + 1) % 100:02d}"
        for code, league in leagues.items():
            url = (
                "https://www.football-data.co.uk/"
                f"mmz4281/{season}/{code}.csv"
            )
            try:
                raw = download(url).decode("latin-1")
                for row in csv.DictReader(io.StringIO(raw)):
                    if row.get("HomeTeam") and row.get("AwayTeam"):
                        matches.append({
                            "season": season,
                            "league": league,
                            "date": row.get("Date"),
                            "home": row.get("HomeTeam"),
                            "away": row.get("AwayTeam"),
                            "home_goals": row.get("FTHG"),
                            "away_goals": row.get("FTAG"),
                            "result": row.get("FTR"),
                        })
            except Exception as error:
                print(f"No se pudo descargar {season} {code}: {error}")

    (DATA / "soccer_matches.json").write_text(
        json.dumps(matches, ensure_ascii=False, indent=2),
        encoding="utf-8"
    )
    print(f"Fútbol: {len(matches)} partidos guardados")

def update_nfl():
    # Calendario histórico publicado por nflverse
    url = (
        "https://github.com/nflverse/nfldata/"
        "releases/download/schedules/schedules.csv"
    )
    try:
        raw = download(url).decode("utf-8-sig")
        rows = list(csv.DictReader(io.StringIO(raw)))
        (DATA / "nfl_schedule.json").write_text(
            json.dumps(rows, ensure_ascii=False, indent=2),
            encoding="utf-8"
        )
        print(f"NFL: {len(rows)} partidos de calendario guardados")
    except Exception as error:
        raise RuntimeError(
            "Falló la descarga del calendario NFL; "
            "revisa la URL de la fuente: " + str(error)
        )

if __name__ == "__main__":
    update_soccer()
    update_nfl()
    (DATA / "last_updated.json").write_text(
        json.dumps({
            "updated_at": datetime.now(timezone.utc).isoformat(),
            "sources": ["Football-Data.co.uk", "nflverse"]
        }, indent=2),
        encoding="utf-8"
    )
